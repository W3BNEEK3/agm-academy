# Copy this file to .env.local and set real values.
# Credentials for the /admin registrations page (HTTP Basic Auth).
ADMIN_USER=
ADMIN_PASSWORD=

# Paystack API keys. Use test keys (sk_test_/pk_test_) until the payment
# flow is fully verified; only switch to live keys when ready to accept
# real payments.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
